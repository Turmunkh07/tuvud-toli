# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Turso (LibSQL) database — from `turso db show <db>` and `turso db tokens create <db>`
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# Admin CMS access — a JSON array of named admins, e.g.:
# ADMIN_USERS=[{"name":"Alice","password":"..."},{"name":"Bob","password":"..."}]
ADMIN_USERS=

# Signing key for admin session cookies. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# SMTP for collaborator invitations (e.g. SMTP2GO). Optional: without it invites
# still create the account and show you the password to pass on by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public URL used in invite emails. Falls back to the Vercel URL, then the request host.
APP_URL=
